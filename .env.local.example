# Supabase — new-style publishable key (preferred) or the legacy anon key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Server-only. Never expose to the browser.
# Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection. Used by `npm run db:push`, and by the app itself
# when it runs on Node. On Cloudflare Workers this is replaced by the HYPERDRIVE
# binding — see docs/DEPLOY.md.
# Project Settings -> Database -> Connection string -> URI (pooler, not db.<ref>)
SUPABASE_DB_URL=postgresql://postgres.<ref>:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage
NEXT_PUBLIC_TICKET_BUCKET=ticket-attachments

# ---------------------------------------------------------------------------
# Telegram bots (Phase 2)
# ---------------------------------------------------------------------------
# Two bots, one codebase:
#   employee — everybody. Opens and follows their own tickets. 8 commands.
#   staff    — IT support and admins only. Queue, claim, status. 14 commands.
# Create each with @BotFather. The `BOT_TELE_*` aliases below are the names used
# in the Cloudflare dashboard this project was set up from; the TELEGRAM_*
# names win when both are present.

# Employee bot (laporkan masalah)
BOT_TELE_KARYAWAN=123456:ABC-employee-bot-token
# TELEGRAM_EMPLOYEE_BOT_TOKEN=123456:ABC-employee-bot-token

# Staff bot (antrean tim IT)
BOT_TELE_ADMIN=789012:DEF-staff-bot-token
# TELEGRAM_STAFF_BOT_TOKEN=789012:DEF-staff-bot-token

# Telegram echoes this back in the X-Telegram-Bot-Api-Secret-Token header on
# every webhook call; the endpoint rejects anything that does not match.
# Both bots use the same secret.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=change-me

# Optional. Shown as t.me deep links on the profile page.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_employee_bot_username
NEXT_PUBLIC_TELEGRAM_STAFF_BOT_USERNAME=your_staff_bot_username

# Shared secret for the notification dispatcher cron endpoint.
DISPATCH_SECRET=change-me-too

# ---------------------------------------------------------------------------
# Optional — only needed to run `npm run verify` against an instance whose
# seeded passwords have been rotated (for example the public demo, where only
# employee1@helpdesk.test keeps the published password).
#
# Leave unset on a fresh clone: verify then uses `Password123!` for every seeded
# account, which is what seed.sql sets.
# ---------------------------------------------------------------------------
# VERIFY_PASSWORD=
